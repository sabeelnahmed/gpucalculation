{
  "_metadata": {
    "last_updated": "2026-03-17",
    "version": "2.0",
    "notes": "Unified file for the cost comparison section on Screen 6. Cloud GPU providers show cost of renting the SAME self-hosted model. API providers show cost of using a DIFFERENT closed-source model. Both are per-month calculations.",
    "formulas": {
      "cloud_gpu_monthly": "hourly_rate × num_gpus × monthly_hours (730 for 24/7, custom for business hours)",
      "api_monthly": "(monthly_input_tokens / 1e6 × input_per_million) + (monthly_output_tokens / 1e6 × output_per_million)",
      "monthly_tokens": {
        "input": "concurrent_users × requests_per_day × 30 × avg_input_tokens_per_request",
        "output": "concurrent_users × requests_per_day × 30 × avg_output_tokens_per_request"
      }
    },
    "avg_tokens_by_use_case": {
      "chatbot":        { "input": 1500, "output": 400 },
      "knowledge":      { "input": 2000, "output": 500 },
      "summarization":  { "input": 3000, "output": 500 },
      "code":           { "input": 2000, "output": 800 },
      "compliance":     { "input": 5000, "output": 1000 },
      "arabic":         { "input": 1500, "output": 400 },
      "batch":          { "input": 2000, "output": 300 },
      "custom":         { "input": 2000, "output": 500 }
    }
  },

