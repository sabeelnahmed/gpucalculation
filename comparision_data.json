  "self_hosted_costs": {
    "_description": "Monthly operating costs for on-premise deployment. Used as the 'self-hosted' bar in the comparison.",
    "formula": {
      "monthly_power_sar": "(gpu_tdp_watts × num_gpus × pue × 730) / 1000 × electricity_sar_per_kwh",
      "monthly_power_usd": "monthly_power_sar / 3.75"
    },
    "constants": {
      "electricity_sar_per_kwh": 0.048,
      "pue": 1.4,
      "hours_per_month_24_7": 730,
      "usd_to_sar": 3.75
    },
    "note": "Self-hosted monthly = power cost only. Hardware is one-time purchase shown in GPU table. Managed services quoted separately (*)"
  }
