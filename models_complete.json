{
  "_metadata": {
    "last_updated": "2026-03-17",
    "version": "2.0",
    "notes": "Complete catalog of open-source/open-weight LLMs relevant for enterprise self-hosting. Memory formulas: FP16 = params × 2 bytes, INT8 = params × 1 byte, INT4 = params × 0.5 bytes. For MoE models, total weight memory uses total_params (all experts must be in memory), but compute cost uses active_params.",
    "kv_cache_formula": "per_token_bytes = 2 × num_layers × num_kv_heads × head_dim × bytes_per_value",
    "categories": {
      "tiny": "Under 3B — edge, mobile, embedded",
      "small": "3-9B — single consumer GPU, fast inference",
      "medium": "10-34B — workstation or single data center GPU",
      "large": "35-80B — multi-GPU or high-end single GPU",
      "xlarge": "100B+ — multi-GPU required",
      "frontier": "400B+ — full node or multi-node"
    }
  },

